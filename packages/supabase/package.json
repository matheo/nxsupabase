{
  "name": "@matheo/supabase",
  "version": "0.2.1",
  "description": "Nx plugin for Supabase - Automated migrations, type generation, and local dev setup for Nx monorepos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nxsupabase/nxsupabase.git"
  },
  "keywords": [
    "nx",
    "nx-plugin",
    "supabase",
    "postgres",
    "postgresql",
    "edge-functions",
    "deno",
    "database",
    "migrations",
    "type-generation",
    "x402",
    "payments",
    "micropayments"
  ],
  "files": [
    "dist",
    "executors.json",
    "generators.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "generators": "./generators.json",
  "executors": "./executors.json",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@matheo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./generators.json": "./generators.json",
    "./executors.json": "./executors.json"
  },
  "peerDependencies": {
    "@nx/devkit": ">=18.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "dotenv": "^16.4.5",
    "detect-port": "^1.5.1"
  }
}
