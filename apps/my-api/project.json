{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/my-api/src",
  "prefix": "api",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "apps/my-api/dist",
        "format": [
          "cjs"
        ],
        "bundle": false,
        "main": "apps/my-api/src/main.ts",
        "tsConfig": "apps/my-api/tsconfig.app.json",
        "assets": [
          "apps/my-api/src/assets"
        ],
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            }
          }
        }
      }
    },
    "prune-lockfile": {
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/apps/my-api/dist/package.json",
        "{workspaceRoot}/apps/my-api/dist/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      },
      "cache": true,
      "dependsOn": [
        "build"
      ]
    },
    "copy-workspace-modules": {
      "executor": "@nx/js:copy-workspace-modules",
      "outputs": [
        "{workspaceRoot}/apps/my-api/dist/workspace_modules"
      ],
      "options": {
        "buildTarget": "build"
      },
      "cache": true,
      "dependsOn": [
        "build"
      ]
    },
    "prune": {
      "executor": "nx:noop",
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ]
    },
    "serve": {
      "executor": "@nx/js:node",
      "continuous": true,
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "@matheo/my-api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "@matheo/my-api:build:development"
        },
        "production": {
          "buildTarget": "@matheo/my-api:build:production"
        }
      }
    },
    "supabase-start": {
      "executor": "@matheo/supabase:start",
      "options": {
        "supabaseDirectory": "apps/my-api/supabase"
      }
    },
    "supabase-stop": {
      "executor": "@matheo/supabase:stop",
      "options": {
        "supabaseDirectory": "apps/my-api/supabase"
      }
    },
    "supabase-status": {
      "executor": "@matheo/supabase:status",
      "options": {
        "supabaseDirectory": "apps/my-api/supabase"
      }
    },
    "supabase-db-reset": {
      "executor": "@matheo/supabase:db-reset",
      "options": {
        "supabaseDirectory": "apps/my-api/supabase"
      }
    },
    "supabase-gen-types": {
      "executor": "@matheo/supabase:gen-types",
      "options": {
        "supabaseDirectory": "apps/my-api/supabase",
        "outputPath": "apps/my-api/src/types/supabase.ts"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/supabase/migrations/**/*",
        "{projectRoot}/supabase/config.toml"
      ],
      "outputs": [
        "{projectRoot}/src/types/supabase.ts"
      ]
    },
    "supabase-migrate": {
      "executor": "@matheo/supabase:migrate",
      "options": {
        "supabaseDirectory": "apps/my-api/supabase"
      }
    },
    "supabase-db-push": {
      "executor": "@matheo/supabase:db-push",
      "options": {
        "supabaseDirectory": "apps/my-api/supabase"
      }
    },
    "supabase-deploy": {
      "executor": "@matheo/supabase:deploy",
      "options": {
        "supabaseDirectory": "apps/my-api/supabase"
      }
    }
  }
}
